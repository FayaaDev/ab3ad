{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "allow",
    "external_directory": "allow",
    "webfetch": "allow"
  },
  "model": "openai/gpt-5.4",
  "small_model": "openai/gpt-5.4-mini",
  "command": {
    "finish up": {
      "description": "End-of-day cleanup workflow",
      "template": "End-of-day cleanup workflow:\n\n1. Review git status, staged/unstaged diffs, and recent commit messages.\n2. Commit the day's relevant work with a concise commit message. Do not include secrets or unrelated files.\n3. Push the git branch to its remote.\n4. Run `bd dolt push` to push my beads.\n5. Report the commit hash, git push result, bead push result, and any remaining uncommitted work."
    }
  },
  "mcp": {
    "magicuidesign-mcp": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "-y", "@magicuidesign/mcp@latest"]
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": false
    },
    "n8n-mcp": {
      "type": "local",
      "command": [
        "env",
        "MCP_MODE=stdio",
        "LOG_LEVEL=error",
        "DISABLE_CONSOLE_OUTPUT=true",
        "N8N_API_URL=https://n8n.fayaa92.sa",
        "N8N_API_KEY={file:~/.config/opencode/secrets/n8n-api-key}",
        "npx",
        "n8n-mcp"
      ],
      "enabled": false
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": true
    },
    "supabase": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@supabase/mcp-server-supabase@latest",
        "--access-token",
        "{file:~/.config/opencode/secrets/supabase-access-token}"
      ],
      "enabled": false
    },
    "mastra": {
      "type": "local",
      "command": ["npx", "-y", "@mastra/mcp-docs-server@latest"],
      "enabled": false
    },
    "excalidraw": {
      "type": "remote",
      "url": "https://mcp.excalidraw.com ",
      "enabled": false
    },
    "cloudflare": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {file:~/.config/opencode/secrets/cloudflare-api-token}"
      }
    },
    "cloudflare-docs": {
      "type": "remote",
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "enabled": true
    },
    "cloudflare-bindings": {
      "type": "remote",
      "url": "https://bindings.mcp.cloudflare.com/mcp",
      "enabled": true,
      "oauth": {}
    },
    "cloudflare-builds": {
      "type": "remote",
      "url": "https://builds.mcp.cloudflare.com/mcp",
      "enabled": true,
      "oauth": {}
    },
    "cloudflare-observability": {
      "type": "remote",
      "url": "https://observability.mcp.cloudflare.com/mcp",
      "enabled": true,
      "oauth": {}
    },
    "cloudflare-browser": {
      "type": "remote",
      "url": "https://browser.mcp.cloudflare.com/mcp",
      "enabled": true,
      "oauth": {}
    }
  }
}
