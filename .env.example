APP_URL=http://localhost:3000
SAMPLE_ASSET_BASE_URL=http://localhost:3000/api/assets/samples
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_SESSION_DAYS=30
ADMIN_EMAILS=admin@example.com
ADMIN_USER_IDS=
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=replace-with-a-strong-password
ADMIN_SEED_NAME=ab3ad Admin
HEALTHCHECK_TOKEN=

DATABASE_URL=postgres://ab3ad:ab3ad@127.0.0.1:5432/ab3ad
DATABASE_SSL=false
DATABASE_POOL_MAX=10
# Set to ab3ad_production for the production external worker and admin scripts.
DATABASE_SCHEMA=

REDIS_URL=redis://127.0.0.1:6379
JOB_QUEUE_NAME=ab3ad-generation-jobs
JOB_QUEUE_MODE=redis
JOB_WORKER_CONCURRENCY=4
PREVIEW_GLB_GENERATION=disabled

STORAGE_DRIVER=r2
# Used only when STORAGE_DRIVER=local.
STORAGE_ROOT=./data/storage

R2_ACCOUNT_ID=48327d5892e89d4a916a72b8dd3c112d
R2_BUCKET=ab3ad-production
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional when you want to provide the full endpoint instead of deriving it from R2_ACCOUNT_ID.
R2_ENDPOINT=

HI3D_BASE_URL=https://api.hitem3d.ai
HI3D_CLIENT_ID=
HI3D_CLIENT_SECRET=
HI3D_CALLBACK_URL=http://localhost:3000/api/hi3d/callback
HI3D_CALLBACK_URL_FIELD=callback_url
HI3D_CALLBACK_SECRET=
HI3D_CALLBACK_SECRET_FIELD=callback_secret
HI3D_ALLOW_UNSIGNED_CALLBACKS=false
HI3D_ALLOWED_RESULT_HOSTS=
HI3D_SUBMIT_EXTRA_FIELDS=
HI3D_FETCH_TIMEOUT_MS=30000
HI3D_MAX_POLL_ATTEMPTS=10
HI3D_MODE=mock

HYPER3D_MODE=mock
HYPER3D_API_KEY=
HYPER3D_BASE_URL=https://api.hyper3d.com/api/v2
HYPER3D_FETCH_TIMEOUT_MS=30000
HYPER3D_ALLOWED_RESULT_HOSTS=

PRINTPAL_MODE=mock
PRINTPAL_API_KEY=
PRINTPAL_CREATE_URL=
PRINTPAL_STATUS_URL_TEMPLATE=

STORAGE_FETCH_TIMEOUT_MS=30000
MAX_UPLOAD_MB=20
